<?xml version="1.0" encoding="utf-8"?>
<!-- FILE DÙNG CHUNG – đã khai báo đủ mọi Activity, không ai cần sửa -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Employee Manager"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.EmployeeManager">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".activities.LoginActivity" />
        <activity android:name=".activities.AdminHomeActivity" />
        <activity android:name=".activities.EmployeeHomeActivity" />

        <!-- A -->
        <activity android:name=".activities.EmployeeListActivity" />
        <activity android:name=".activities.EmployeeFormActivity" />

        <!-- B -->
        <activity android:name=".activities.CheckInActivity" />
        <activity android:name=".activities.AttendanceHistoryActivity" />

        <!-- C -->
        <activity android:name=".activities.SalaryAdminActivity" />
        <activity android:name=".activities.MySalaryActivity" />
    </application>

</manifest>
